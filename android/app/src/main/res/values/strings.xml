    <!-- strip setup -->
    <string name="setup_title">Set up a strip</string>
    <string name="setup_step1">Hold the strip\'s main button for about 10 seconds until the light blinks fast.</string>
    <string name="setup_step2">In the phone\'s Wi-Fi settings join the network that starts with TONLY_TAP_ (e.g. TONLY_TAP_91C0C4C). Its password is LGU_ followed by the same letters and numbers that come after TONLY_TAP_ (in the example: LGU_91C0C4C). If Android says there is no internet, choose to stay connected.</string>
    <string name="setup_step3">Come back here, fill in the fields below and tap Send.</string>
    <string name="setup_step4">When it says done, switch the phone back to your home Wi-Fi. The strip appears on the home screen within a minute.</string>
    <string name="setup_server_ip">Server IP</string>
    <string name="setup_advanced">Advanced</string>
    <string name="setup_server_ip_hint">The IPv4 address the strip will connect to: the server\'s fixed public IP (works from anywhere), or the computer\'s home IP.</string>
    <string name="setup_wifi_name">Home Wi-Fi name</string>
    <string name="setup_wifi_hint">2.4 GHz networks only. The strip cannot use 5 GHz.</string>
