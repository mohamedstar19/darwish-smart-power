# systemd unit for running Darwish Smart Power on a Linux server / VPS.
#   sudo cp smartpower.service /etc/systemd/system/
#   sudo nano /etc/systemd/system/smartpower.service     # set User, paths, token, public IP
#   sudo systemctl daemon-reload && sudo systemctl enable --now smartpower
#   journalctl -u smartpower -f
[Unit]
Description=Darwish Smart Power (MTTL-W01 strip server)
After=network-online.target
Wants=network-online.target

[Service]
User=mk
WorkingDirectory=/home/mk/darwish-smart-power
Environment=SP_TOKEN=change-me-to-a-long-random-token
Environment=SP_PUBLIC_IP=192.168.1.116
Environment=SP_WEB_PORT=8090
ExecStart=/usr/bin/python3 /home/mk/darwish-smart-power/smartpower.py serve
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
